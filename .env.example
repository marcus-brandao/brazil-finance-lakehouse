DATABRICKS_HOST=https://<your-workspace>.cloud.databricks.com
DATABRICKS_TOKEN=
# Optional. Free Edition does not let the API create catalogs, so the default is
# the workspace's own catalog, named "workspace".
DATABRICKS_CATALOG=workspace
# For dbt. SQL Warehouses, open the warehouse, Connection details, HTTP path.
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/<warehouse-id>
